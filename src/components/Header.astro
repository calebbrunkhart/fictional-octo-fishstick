---
import profile from '../../data/profile.json';
import ThemeToggle from './ThemeToggle.client';
---
<header class="site-container flex items-center justify-between py-6">
  <div class="flex items-center gap-4">
    <a href="/" class="flex items-center gap-3">
      <img src="/avatar-placeholder.svg" alt="avatar" class="w-12 h-12 rounded-lg" />
      <div>
        <div class="text-lg font-semibold">{profile.name}</div>
        <div class="text-sm text-slate-500 dark:text-slate-400">{profile.title} • {profile.institution}</div>
      </div>
    </a>
  </div>

  <nav class="flex items-center gap-4">
    <a class="text-sm hover:underline" href="/">Home</a>
    <a class="text-sm hover:underline" href="/research">Research</a>
    <a class="text-sm hover:underline" href="/publications">Publications</a>
    <a class="text-sm hover:underline" href="/teaching">Teaching</a>
    <a class="text-sm hover:underline" href="/blog">Blog</a>
    <a class="text-sm hover:underline" href="/contact">Contact</a>
    <ThemeToggle />
  </nav>
</header>
