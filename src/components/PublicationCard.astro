---
const p = Astro.props.pub;
---
<article class="card">
  <div>
    <div class="flex items-center justify-between">
      <h4 class="font-semibold">{p.title}</h4>
      <div class="text-xs text-slate-400">{p.year}</div>
    </div>
    <div class="text-sm text-slate-400 mt-2">{p.authors.join(', ')} — <em>{p.venue}</em></div>
    {p.notes ? <div class="mt-2 text-xs text-amber-300">{p.notes}</div> : null}
    <div class="mt-3">
      {p.tags?.map((t) => <span class="inline-block text-xs mr-2 px-2 py-1 rounded-full bg-slate-700/30 text-slate-200">{t}</span>)}
    </div>
  </div>
</article>
