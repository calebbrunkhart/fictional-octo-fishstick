---
import profile from '../../data/profile.json';
const year = new Date().getFullYear();
---
<footer class="site-container border-t border-slate-200/5 py-8">
  <div class="flex flex-col md:flex-row md:justify-between gap-4">
    <div>
      <div class="font-semibold">{profile.name}</div>
      <div class="text-sm text-slate-500 dark:text-slate-400">{profile.institution} • {profile.location}</div>
    </div>
    <div class="text-sm text-slate-500 dark:text-slate-400">
      <div>Built with Astro · TypeScript · Tailwind</div>
      <div>© {year} {profile.name}</div>
    </div>
  </div>
</footer>
