---
const { title, children, link } = Astro.props;
---
<article class="card">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="text-lg font-semibold">{title}</h3>
      <div class="mt-3 text-sm text-slate-400">
        <slot />
      </div>
    </div>
    {link ? <a href={link} class="text-sm underline self-start">Open</a> : null}
  </div>
</article>
