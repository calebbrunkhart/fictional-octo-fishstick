---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About — Caleb Brunkhart">
  <section>
    <h1 class="text-3xl font-bold">About</h1>
    <p class="text-slate-400 mt-2">Academic timeline and service highlights.</p>

    <section class="mt-6 card">
      <h3 class="font-semibold">Academic & Service Timeline</h3>
      <ol class="mt-4 border-l border-slate-700/20 pl-4">
        <li class="mb-4">
          <div class="text-sm font-medium">2021 — Started B.S. Computer Science</div>
          <div class="text-sm text-slate-400">Admitted to University of Montana, focusing on software engineering coursework.</div>
        </li>
        <li class="mb-4">
          <div class="text-sm font-medium">2022 — Undergraduate Research Assistant</div>
          <div class="text-sm text-slate-400">Joined a lab focusing on requirements engineering and traceability.</div>
        </li>
        <li class="mb-4">
          <div class="text-sm font-medium">2023 — Conference Paper</div>
          <div class="text-sm text-slate-400">Published first paper on traceability tooling.</div>
        </li>
        <li class="mb-4">
          <div class="text-sm font-medium">2024 — Program Committee / Volunteer</div>
          <div class="text-sm text-slate-400">Served as student volunteer for software engineering workshop and local conference events.</div>
        </li>
      </ol>
    </section>
  </section>
</BaseLayout>
